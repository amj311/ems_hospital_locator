generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Device {
    device_id            String @id @default(uuid())
    public_key           String @unique
    exchange_public_key  String @unique
    recovery_public_key  String @unique
    recovery_fingerprint String @unique

    // a password is still used to login to the device so that it can be logged out and 
    password_hash String

    SharedTo   LocationShare[] @relation("SharedFromDevice")
    SharedFrom LocationShare[] @relation("SharedToDevice")

    // When a device account is "recovered" from an external device, we invalidate the previous device and delete all its shares
    revoked_at           DateTime?
    revoked_by           Device?         @relation(name: "DeviceRevokedBy", fields: [revoked_by_device_id], references: [device_id])
    revoked_by_device_id String?
    revoked_devices      Device[]        @relation("DeviceRevokedBy")
    revoked_shares       LocationShare[] @relation("ShareRevokedBy")
}

// Each share carries a unique encrypted copy of the location, each updated by the sharing device.
// The sharing device will generate an encryption key and give it to the receiving device through a secure channel.
// The receiving device may download the encrypted location if it is authenticated and has an active share,
// but it will still need the correct key to decrypt the location
model LocationShare {
    location_share_id String @unique @default(uuid())
    FromDevice        Device @relation(name: "SharedFromDevice", fields: [from_device_id], references: [device_id])
    from_device_id    String
    ToDevice          Device @relation(name: "SharedToDevice", fields: [to_device_id], references: [device_id])
    to_device_id      String

    shared_at            DateTime
    revoked_at           DateTime?
    revoked_by           Device?   @relation(name: "ShareRevokedBy", fields: [revoked_by_device_id], references: [device_id])
    revoked_by_device_id String?

    locationRequests LocationRequest[]
    locationUpdates  LocationUpdate[]

    @@id([from_device_id, to_device_id])
}

model ShareRequest {
    from_device_id String   @unique
    to_device_id   String
    requested_at   DateTime
    reciprocate    Boolean? @default(false)
    share_payload  Json
}

// All location requests are logged for transparency (perhaps with a TTL)
model LocationRequest {
    location_request_id       String        @id @default(uuid())
    share                     LocationShare @relation(fields: [location_share_id], references: [location_share_id])
    requesting_from_device_id String? // this is optional so we can store and report an invalid attempt to request a location
    requesting_for_device_id  String
    location_share_id         String

    requested_at DateTime
}

model LocationUpdate {
    location_update_id String        @id @default(uuid())
    location_share_id  String
    share              LocationShare @relation(fields: [location_share_id], references: [location_share_id])
    location           String
    timestamp          DateTime
}

model Challenge {
    challenge_id String    @id @default(uuid())
    device_id    String    @unique // Let's not bother keeping old challenges around
    nonce        String // 32-byte random, base64url encoded
    expires_at   DateTime
    used_at      DateTime?
    created_at   DateTime  @default(now())

    @@index([device_id])
    @@index([nonce])
}

model Session {
    challenge_id String   @id @default(uuid())
    device_id    String   @unique // Let's not bother keeping old sessions around
    token_hash   String // 32-byte random, base64url encoded
    expires_at   DateTime
    created_at   DateTime @default(now())

    refresh_token_hash String
    refresh_expires_at DateTime

    @@index([device_id])
}
